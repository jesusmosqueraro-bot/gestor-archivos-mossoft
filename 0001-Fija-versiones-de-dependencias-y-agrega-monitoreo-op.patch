From 2e21f903cb583b6fcc6f4024a9074352f7c03a0c Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 13 Sep 2026 20:28:56 +0000
Subject: [PATCH 1/2] Fija versiones de dependencias y agrega monitoreo
 opcional con Sentry
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Prioridad media del checklist de salida a producción:

- requirements.txt: ~10 dependencias que estaban sin versión fija
  (psycopg2-binary, cloudinary, requests, cryptography, bleach, tinycss2,
  reportlab, Pillow, openpyxl) quedan ancladas a la versión ya instalada y
  probada contra la suite completa. Sin esto, un build nuevo en Render podía
  traer sin avisar una versión mayor con cambios de comportamiento.
  pip-audit (job "auditoria-dependencias" en CI) sigue corriendo en cada push
  para avisar si alguna de estas versiones fijadas queda con una
  vulnerabilidad conocida.

- app.py + requirements.txt: inicialización opcional de Sentry, activada
  solo si se define SENTRY_DSN en Render. Sin esa variable, el bloque no
  hace nada. send_default_pii=False para no enviar credenciales de la
  bóveda ni datos de salud a un tercero.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
---
 app.py           | 25 +++++++++++++++++++++++++
 requirements.txt | 29 +++++++++++++++++++----------
 2 files changed, 44 insertions(+), 10 deletions(-)

diff --git a/app.py b/app.py
index fc4344c..9ad5d10 100644
--- a/app.py
+++ b/app.py
@@ -129,6 +129,31 @@ except Exception:
     anthropic = None
 
 app = Flask(__name__)
+
+# 🩺 Monitoreo de errores (opcional, 13/09/2026): hoy, si algo falla en producción, el traceback
+# solo queda en los logs de Render (nadie se entera hasta que un usuario reporta el problema).
+# Si se define SENTRY_DSN en las variables de entorno de Render, cada excepción no manejada (un
+# error 500) se envía también a Sentry en tiempo real, con alerta. Sin esa variable, este bloque
+# no hace absolutamente nada — cero riesgo para quien no lo configure. `sentry-sdk` es una
+# dependencia opcional (ver requirements.txt): si no está instalada, también se ignora en
+# silencio en vez de tumbar el arranque de la app.
+_SENTRY_DSN = os.environ.get('SENTRY_DSN')
+if _SENTRY_DSN:
+    try:
+        import sentry_sdk
+        from sentry_sdk.integrations.flask import FlaskIntegration
+        sentry_sdk.init(
+            dsn=_SENTRY_DSN,
+            integrations=[FlaskIntegration()],
+            # No se envía el cuerpo de las peticiones (podría incluir credenciales de la
+            # bóveda, notas de PQRS, datos de salud, etc.) — solo metadata del error.
+            send_default_pii=False,
+            traces_sample_rate=0.0,
+        )
+        print("✅ Sentry inicializado: las excepciones no manejadas se reportarán en tiempo real.")
+    except Exception as _e:
+        print(f"⚠️ SENTRY_DSN está configurada pero Sentry no se pudo inicializar ({_e}); "
+              f"la app sigue funcionando normal, solo sin ese monitoreo.")
 # 🔐 SECRET_KEY: nunca debe tener un valor real escrito en el código (quedaría expuesto en GitHub).
 # Si no está seteada en las variables de entorno de Render, se genera una aleatoria en cada arranque.
 # Esto no causa fricción extra: las sesiones ya se invalidan en cada reinicio por SERVER_INSTANCE_ID (ver abajo).
diff --git a/requirements.txt b/requirements.txt
index b450ab4..7808e74 100644
--- a/requirements.txt
+++ b/requirements.txt
@@ -10,19 +10,28 @@ Flask==3.1.3
 Werkzeug==3.1.8
 Flask-WTF==1.2.1
 gunicorn==26.2.0
-psycopg2-binary
-cloudinary
-requests
-cryptography
-bleach
-tinycss2
-reportlab
-Pillow
-openpyxl
+# 📌 Fijadas (13/09/2026): estaban sin versión, así que un build nuevo en Render podía traer sin
+# avisar una versión mayor con cambios de comportamiento. Se fijan a las versiones ya instaladas
+# y probadas contra la suite completa en este momento. `pip-audit` (job "auditoria-dependencias")
+# sigue corriendo en cada push para detectar si alguna de estas queda con una vulnerabilidad
+# conocida y hay que subirle la versión a propósito.
+psycopg2-binary==2.9.13
+cloudinary==1.46.2
+requests==2.34.2
+cryptography==50.0.1
+bleach==6.4.0
+tinycss2==1.5.1
+reportlab==5.0.1
+Pillow==12.3.0
+openpyxl==3.1.5
 pyotp==2.10.0
-anthropic
+anthropic==1.5.0
 Flask-Limiter==3.8.0
 redis==5.0.8
 Flask-SocketIO==5.6.1
 gevent==26.8.0
 gevent-websocket==0.10.1
+# 🩺 Opcional: solo se activa si se define SENTRY_DSN en Render (ver comentario junto a
+# sentry_sdk.init en app.py). Si esta librería llegara a faltar, el arranque no se cae —
+# el bloque de inicialización lo captura y sigue sin ese monitoreo.
+sentry-sdk[flask]==2.19.2
