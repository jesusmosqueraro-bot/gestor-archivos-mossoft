# Base de datos local de pruebas (en producción se usa Postgres/Neon vía DATABASE_URL).
gestor.db
*.db

# Cache de Python
__pycache__/
*.pyc
.pytest_cache/

# Entorno virtual local usado solo para correr la suite de pruebas en este entorno de trabajo
# (no es parte del código de la app ni se despliega a Render).
.venv/

# Variables de entorno locales, si alguna vez se usa un archivo .env
.env

# Documentos de entrega/propuesta y mockups de diseño: no son parte de la app, se generan y
# entregan por fuera (ver SendUserFile) — no deben vivir en este repo de código.
/docs_entrega/
/mockups/
