diff --git a/package.json b/package.json
new file mode 100644
index 0000000..41358ba
--- /dev/null
+++ b/package.json
@@ -0,0 +1,11 @@
+{
+  "name": "arkiv-tailwind-build",
+  "private": true,
+  "description": "Solo para compilar Tailwind CSS a un archivo estático (static/css/tailwind.min.css) antes de desplegar. Render no ejecuta ningún paso de build de Node — el archivo compilado se versiona en el repo y se sirve tal cual.",
+  "scripts": {
+    "build:css": "tailwindcss -i ./static/css/tailwind-input.css -o ./static/css/tailwind.min.css --minify"
+  },
+  "devDependencies": {
+    "tailwindcss": "^3.4.13"
+  }
+}
diff --git a/static/css/tailwind-input.css b/static/css/tailwind-input.css
new file mode 100644
index 0000000..717c1c2
--- /dev/null
+++ b/static/css/tailwind-input.css
@@ -0,0 +1,10 @@
+/* Fuente para compilar static/css/tailwind.min.css con `npm run build:css` (ver tailwind.config.js
+   y package.json). Reemplaza a <script src="https://cdn.tailwindcss.com"> — ese script compilaba
+   Tailwind EN EL NAVEGADOR, en cada carga de página, lo cual era la causa principal de la lentitud
+   reportada (confirmado por la propia advertencia de consola de Chrome: "cdn.tailwindcss.com
+   should not be used in production"). Este archivo se compila UNA sola vez aquí y el resultado ya
+   minificado se sirve como un .css estático normal, sin recompilar nada en el navegador de quien
+   visita la página. */
+@tailwind base;
+@tailwind components;
+@tailwind utilities;
